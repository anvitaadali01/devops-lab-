#include <tunables/global>

profile flask-apparmor flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  network inet,
  network inet6,
  network unix stream,

  capability net_bind_service,
  deny capability sys_admin,

  /app/** rw,
  /app/** r,
  /tmp/** rw,
  /tmp/** r,

  deny /etc/** r,
  deny /etc/** w,
  deny /var/** rw,
  deny /bin/** rmix,
  deny /usr/bin/** rmix,
  deny /sbin/** rmix,
  deny /usr/sbin/** rmix,
  deny /root/** rw,

  /usr/local/bin/python* rix,
  /usr/local/lib/python*/** r,
  /usr/local/lib/python*/** mr,
  /lib/** r,
  /usr/lib/** r,
  /dev/null rw,
  /dev/urandom r,
  /proc/** r,
  /proc/sys/** r,
}
